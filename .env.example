# Copy this file to .env. Never commit the resulting .env file.
FLASK_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=sqlite:///instance/paperplazo.db
UPLOAD_FOLDER=uploads
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-first-run
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COD_ENABLED=true
# Set shipping rules before accepting live checkout orders. Amounts are in INR.
SHIPPING_RATE=0
FREE_SHIPPING_THRESHOLD=0
LOW_STOCK_THRESHOLD=10

# Firebase web configuration values from the Firebase Console.
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=paperplazo.firebaseapp.com
FIREBASE_PROJECT_ID=paperplazo
FIREBASE_STORAGE_BUCKET=paperplazo.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id_here
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK credentials for provisioning admin custom claims.
# Either place a service-account JSON file outside the repo and point here,
# or set GOOGLE_APPLICATION_CREDENTIALS to that file path.
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

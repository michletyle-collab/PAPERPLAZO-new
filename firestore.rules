rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUserDocument() {
      return request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role == 'customer';
    }

    function validProductDocument() {
      return request.resource.data.keys().hasAll([
          'name', 'description', 'price', 'category', 'imageUrl', 'stock', 'sku',
          'isActive', 'createdAt', 'updatedAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'description', 'price', 'category', 'categoryId', 'categorySlug',
          'imageUrl', 'stock', 'sku', 'isActive', 'product_code', 'slug', 'discount_price',
          'selling_price', 'in_stock', 'paper_gsm', 'dimensions', 'handle_type',
          'customization_available', 'status', 'is_featured', 'is_best_seller', 'images',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 10000
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.sku is string
        && request.resource.data.sku.size() > 0
        && request.resource.data.sku.size() <= 50
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.status in ['draft', 'active', 'inactive']
        && request.resource.data.isActive == (request.resource.data.status == 'active');
    }

    function orderBelongsToCustomer() {
      return signedIn() && resource.data.customerUid == request.auth.uid;
    }

    function orderUpdateIsCustomerSafe() {
      return request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.total == resource.data.total
        && request.resource.data.payment_status == resource.data.payment_status
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.status == resource.data.status
        && request.resource.data.role == resource.data.role
        && request.resource.data.adminRole == resource.data.adminRole
        && request.resource.data.customerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserDocument();

      allow read: if signedIn() && (isAdmin() || request.auth.uid == userId);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.name is string
        && request.resource.data.role == 'customer'
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.isActive == true;

      allow create: if isAdmin()
        && validProductDocument()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && validProductDocument()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'Pending'
        && request.resource.data.payment_status == 'Payment Pending';

      allow read: if isAdmin() || orderBelongsToCustomer();

      allow update: if isAdmin()
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.total == resource.data.total
        && request.resource.data.role == resource.data.role
        && request.resource.data.adminRole == resource.data.adminRole;

      allow update: if signedIn()
        && orderBelongsToCustomer()
        && orderUpdateIsCustomerSafe();

      allow delete: if false;
    }

    match /customQuotes/{quoteId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.customerUid == request.auth.uid
      );
      allow delete: if false;
    }

    match /settings/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
